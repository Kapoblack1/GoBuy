# MongoDB Atlas SRV URI (recomendado)
# Formato: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gobuy?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret
JWT_SECRET=defina_um_segredo_unico_e_seguro_aqui

# Server
PORT=5000

# Email Configuration (Para desenvolvimento com Gmail)
# Use uma "Senha de app" do Gmail (não a senha da conta)
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=senha-de-app-de-16-caracteres

# Ou para produção com SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# App Environment
NODE_ENV=development